{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_EAGLE_EYES_WORLD_DATA_URL": "https://eagle-eyes-world-data-v2.salathaniebrown.chatgpt.site"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "device": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_EAGLE_EYES_WORLD_DATA_URL": "https://eagle-eyes-world-data-v2.salathaniebrown.chatgpt.site"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_EAGLE_EYES_WORLD_DATA_URL": "https://eagle-eyes-world-data-v2.salathaniebrown.chatgpt.site"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      }
    }
  }
}
