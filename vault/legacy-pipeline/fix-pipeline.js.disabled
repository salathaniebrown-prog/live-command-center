/*
 * EAGLE EYES LEGACY PIPELINE ARCHIVE
 * ----------------------------------
 * STATUS: DISABLED / REFERENCE ONLY
 * DO NOT RUN AGAINST THE CURRENT V13 REPOSITORY.
 *
 * This script is preserved for historical reference only. It would overwrite
 * package.json and create an additional GitHub Actions workflow that can conflict
 * with the current Eagle Eyes V13 configuration.
 *
 * No secret values are stored here. Keep VERCEL_TOKEN and all API keys in the
 * appropriate encrypted platform secret/environment stores.
 */

const fs = require('fs');
const path = require('path');

console.log("⚡ Starting unified automated configuration deployment...");

// 1. Write .vercelignore
const vercelIgnoreContent = `test/
*.test.js
*.spec.js
production.log
nohup.out`;
fs.writeFileSync('.vercelignore', vercelIgnoreContent);
console.log("✅ Written: .vercelignore");

// 2. Write package.json
const packageJsonContent = {
  "name": "live-command-center",
  "version": "1.0.0",
  "description": "Real-time dashboard for supercomputer and AI infrastructure monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js",
    "test": "node --test test/state-embedding.test.js",
    "ci": "npm run check && npm test"
  },
  "keywords": ["dashboard", "monitoring", "supercomputer", "ai"],
  "author": "Salathanielbrown SR",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
};
fs.writeFileSync('package.json', JSON.stringify(packageJsonContent, null, 2));
console.log("✅ Written: package.json");

// 3. Write GitHub Actions Workflow
const workflowDir = path.join('.github', 'workflows');
if (!fs.existsSync(workflowDir)) {
    fs.mkdirSync(workflowDir, { recursive: true });
}
const workflowContent = `name: Eagle Eyes Live CI/CD Pipeline

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  validate-and-test:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Code Repository
      uses: actions/checkout@v4
    - name: Set up Node.js Runtime
      uses: actions/setup-node@v4
      with:
        node-version: '20'
        cache: 'npm'
    - name: Install Project Dependencies
      run: npm ci
    - name: Run Syntax Checks and Test Suite
      run: npm run ci

  deploy-to-vercel:
    needs: validate-and-test
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    steps:
    - name: Checkout Code Repository
      uses: actions/checkout@v4
    - name: Install Vercel CLI
      run: npm install --global vercel@latest
    - name: Deploy Production Target to Vercel
      run: vercel deploy --prod --token \${{ secrets.VERCEL_TOKEN }} --yes`;

fs.writeFileSync(path.join(workflowDir, 'node.js.yml'), workflowContent);
console.log("✅ Written: .github/workflows/node.js.yml");
console.log("🏆 Infrastructure pipeline sync complete. Run 'npm run ci' to verify local state!");
