# Power Blueprint runtime configuration
# Copy to .env locally if desired. Never commit real secret values.

# Signed/private map data URL used by:
#   ./power-blueprint-tool.sh download-map-data
MAPTILER_DATA_URL=

# Deployment token consumed by deploy_script.py.
H_TOKEN=

# Optional deployment notification webhook.
SLACK_WEBHOOK_URL=

# Optional path overrides.
DEPLOY_SCRIPT=/app/deploy_script.py
POWER_BLUEPRINT_LOG_FILE=/var/log/power-blueprint-deployer.log

# Optional temporary review file removed only by:
#   ./power-blueprint-tool.sh cleanup-review
REVIEW_FILE=
